# Copy this file to `.env` and fill in real values.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000

# Public base URL (ngrok for local webhooks)
APP_BASE_URL="https://your-public-host.example"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# OxaPay merchant (invoices / top-ups) — platform currency is USD
OXAPAY_MERCHANT_API_KEY="your-merchant-api-key"
OXAPAY_SANDBOX="true"
OXAPAY_DEFAULT_CURRENCY="USD"
OXAPAY_CALLBACK_URL="https://your-public-host.example/payments/webhook"
OXAPAY_BASE_URL="https://api.oxapay.com/v1"

# OxaPay payout (wallet withdrawals; currency/network are chosen per request by the user)
OXAPAY_PAYOUT_API_KEY="your-payout-api-key"
OXAPAY_PAYOUT_CALLBACK_URL="https://your-public-host.example/payouts/webhook"

# ── Transport security ─────────────────────────────────────────────
# Response encryption key (base64, 32 bytes). Without it a temporary key is used and changes on restart.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RESPONSE_ENC_PRIVATE_KEY=
# Built-in HTTPS (optional). Leave empty to serve HTTP and terminate TLS in a proxy instead.
TLS_KEY_PATH=
TLS_CERT_PATH=
# Set to 1 when behind a reverse proxy that sets X-Forwarded-Proto (enables HSTS detection).
TRUST_PROXY=
# Comma-separated browser origins allowed by CORS, e.g. https://app.example.com,https://admin.example.com
# Empty = any origin (local development only).
CORS_ORIGINS=
