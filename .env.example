# Copy this file to `.env` and fill in real values.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000

# Public base URL (ngrok for local webhooks)
APP_BASE_URL="https://your-public-host.example"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# OxaPay merchant (invoices / top-ups) — platform currency is USD
OXAPAY_MERCHANT_API_KEY="your-merchant-api-key"
OXAPAY_SANDBOX="true"
OXAPAY_DEFAULT_CURRENCY="USD"
OXAPAY_CALLBACK_URL="https://your-public-host.example/payments/webhook"
OXAPAY_BASE_URL="https://api.oxapay.com/v1"

# OxaPay payout (wallet withdrawals; currency/network are chosen per request by the user)
OXAPAY_PAYOUT_API_KEY="your-payout-api-key"
OXAPAY_PAYOUT_CALLBACK_URL="https://your-public-host.example/payouts/webhook"
