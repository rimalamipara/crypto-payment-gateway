// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?
  name         String?
  passwordHash String
  isActive     Boolean  @default(true)
  posts        Post[]
  userRoles    UserRole[]
  payments       Payment[]
  wallet         Wallet?
  payouts        Payout[]
  pokerSeats     PokerSeat[]
  pokerHandPlayers PokerHandPlayer[]
  pokerActions   PokerAction[]
  colorBets      ColorBet[]
  teenPattiSeats TeenPattiSeat[]
  rummySeats     RummySeat[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  userRoles   UserRole[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt TimestamptzString @default(now())

  @@unique([userId, roleId])
}

model Wallet {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceUsd Decimal  @default(0)
  // Locked funds; withdraw to balanceUsd before betting.
  vaultUsd   Decimal  @default(0)
  currency   String   @default("USD")
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            Int      @id @default(autoincrement())
  walletId      Int
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          String
  amountUsd     Decimal
  balanceAfter  Decimal
  referenceType String?
  referenceId   Int?
  description   String?
  createdAt     TimestamptzString @default(now())

  @@index([walletId])
  @@index([referenceType, referenceId])
}

model Payment {
  id             Int      @id @default(autoincrement())
  orderId        String   @unique
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal
  currency       String   @default("USD")
  purpose        String   @default("topup")
  status         String   @default("new")
  trackId        String?  @unique
  paymentUrl     String?
  description    String?
  email          String?
  returnUrl      String?
  paidCurrency   String?
  paidAmount     String?
  txHash         String?
  webhookPayload String?
  walletCredited Boolean  @default(false)
  expiresAt      TimestamptzString?
  paidAt         TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([userId])
  @@index([status])
}

model Payout {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd      Decimal
  currency       String
  network        String?
  address        String
  status         String   @default("pending")
  trackId        String?  @unique
  txHash         String?
  fee            String?
  memo           String?
  description    String?
  webhookPayload String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([userId])
  @@index([status])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

/// Legacy combined log table (kept for existing rows; new writes use the tables below).
model ApiEventLog {
  id              Int      @id @default(autoincrement())
  direction       String
  source          String   @default("oxapay")
  category        String
  channel         String?
  method          String
  path            String
  url             String?
  requestHeaders  String?
  requestBody     String?
  responseStatus  Int?
  responseBody    String?
  hmacHeader      String?
  signatureValid  Boolean?
  trackId         String?
  orderId         String?
  relatedType     String?
  relatedId       Int?
  success         Boolean  @default(true)
  errorMessage    String?
  createdAt       TimestamptzString @default(now())

  @@index([direction, category])
  @@index([trackId])
  @@index([orderId])
  @@index([createdAt])
}

/// All non-webhook API traffic (inbound Nest routes + outbound OxaPay calls).
model ApiRequestLog {
  id              Int      @id @default(autoincrement())
  direction       String
  source          String
  method          String
  path            String
  url             String?
  requestHeaders  String?
  requestBody     String?
  responseStatus  Int?
  responseBody    String?
  ip              String?
  userId          Int?
  trackId         String?
  orderId         String?
  durationMs      Int?
  success         Boolean  @default(true)
  errorMessage    String?
  createdAt       TimestamptzString @default(now())

  @@index([direction, source])
  @@index([path])
  @@index([trackId])
  @@index([createdAt])
}

model PokerTable {
  id           Int      @id @default(autoincrement())
  name         String
  smallBlind   Decimal
  bigBlind     Decimal
  minBuyIn     Decimal
  maxBuyIn     Decimal
  maxSeats     Int      @default(6)
  rakePercent  Decimal  @default(5)
  rakeCap      Decimal  @default(3)
  status       String   @default("open")
  handCounter  Int      @default(0)
  seats        PokerSeat[]
  hands        PokerHand[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([status])
}

model PokerSeat {
  id        Int      @id @default(autoincrement())
  tableId   Int
  table     PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex Int
  stackUsd  Decimal  @default(0)
  status    String   @default("seated")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([tableId, seatIndex])
  @@unique([tableId, userId])
  @@index([userId])
  @@index([status])
  // Partial unique index name: poker_seat_one_active_per_user
  // (migrations/manual/20261116_poker_one_active_seat.sql). App detects
  // races via PostgreSQL SQLSTATE 23505, not by index name.
}

model PokerHand {
  id        Int      @id @default(autoincrement())
  tableId   Int
  table     PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handNo    Int
  status    String   @default("active")
  board     String?
  potUsd    Decimal  @default(0)
  rakeUsd   Decimal  @default(0)
  dealerSeat Int?
  startedAt TimestamptzString @default(now())
  endedAt   TimestamptzString?
  players   PokerHandPlayer[]
  actions   PokerAction[]

  @@unique([tableId, handNo])
  @@index([status])
  @@index([startedAt])
}

model PokerHandPlayer {
  id            Int      @id @default(autoincrement())
  handId        Int
  hand          PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex     Int
  holeCards     String?
  startingStack Decimal
  endingStack   Decimal?
  betTotal      Decimal  @default(0)
  netPnl        Decimal  @default(0)
  handRank      String?
  createdAt     TimestamptzString @default(now())

  @@unique([handId, userId])
  @@index([userId])
}

model PokerAction {
  id        Int      @id @default(autoincrement())
  handId    Int
  hand      PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  action    String
  amountUsd Decimal  @default(0)
  createdAt TimestamptzString @default(now())

  @@index([handId])
  @@index([userId])
}

model ColorRound {
  id            Int      @id @default(autoincrement())
  periodNo      Int      @unique
  status        String   @default("betting")
  resultNumber  Int?
  resultColors  String?
  startsAt      TimestamptzString
  betsCloseAt   TimestamptzString
  revealsAt     TimestamptzString
  settledAt     TimestamptzString?
  forcedByAdmin Boolean  @default(false)
  presetNumber  Int?
  durationSec   Int      @default(180)
  bets          ColorBet[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([status])
  @@index([startsAt])
}

model ColorBet {
  id         Int      @id @default(autoincrement())
  roundId    Int
  round      ColorRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  betType    String
  selection  String
  amountUsd  Decimal
  payoutUsd  Decimal  @default(0)
  status     String   @default("pending")
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([roundId])
  @@index([userId])
  @@index([status])
}

/// Inbound webhook deliveries only (payment + payout callbacks).
model WebhookLog {
  id              Int      @id @default(autoincrement())
  source          String   @default("oxapay")
  channel         String
  method          String   @default("POST")
  path            String
  requestHeaders  String?
  requestBody     String?
  responseStatus  Int?
  responseBody    String?
  hmacHeader      String?
  signatureValid  Boolean?
  trackId         String?
  orderId         String?
  relatedType     String?
  relatedId       Int?
  success         Boolean  @default(true)
  errorMessage    String?
  createdAt       TimestamptzString @default(now())

  @@index([channel])
  @@index([trackId])
  @@index([orderId])
  @@index([createdAt])
}

model TeenPattiTable {
  id          Int      @id @default(autoincrement())
  name        String
  bootUsd     Decimal  @default(1)
  minBuyIn    Decimal  @default(10)
  maxBuyIn    Decimal  @default(500)
  maxSeats    Int      @default(5)
  status      String   @default("open")
  handCounter Int      @default(0)
  seats       TeenPattiSeat[]
  hands       TeenPattiHand[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([status])
}

model TeenPattiSeat {
  id        Int      @id @default(autoincrement())
  tableId   Int
  table     TeenPattiTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex Int
  stackUsd  Decimal  @default(0)
  status    String   @default("seated")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([tableId, seatIndex])
  @@unique([tableId, userId])
  @@index([userId])
}

model TeenPattiHand {
  id           Int      @id @default(autoincrement())
  tableId      Int
  table        TeenPattiTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handNo       Int
  status       String   @default("running")
  potUsd       Decimal  @default(0)
  winnerUserId Int?
  startedAt    TimestamptzString @default(now())
  endedAt      TimestamptzString?

  @@unique([tableId, handNo])
  @@index([tableId, startedAt])
}

model RummyTable {
  id          Int      @id @default(autoincrement())
  name        String
  pointValue  Decimal  @default(1)
  minBuyIn    Decimal  @default(20)
  maxBuyIn    Decimal  @default(500)
  maxSeats    Int      @default(4)
  status      String   @default("open")
  handCounter Int      @default(0)
  seats       RummySeat[]
  hands       RummyHand[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([status])
}

model RummySeat {
  id        Int      @id @default(autoincrement())
  tableId   Int
  table     RummyTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex Int
  stackUsd  Decimal  @default(0)
  status    String   @default("seated")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([tableId, seatIndex])
  @@unique([tableId, userId])
  @@index([userId])
}

model RummyHand {
  id           Int      @id @default(autoincrement())
  tableId      Int
  table        RummyTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handNo       Int
  status       String   @default("running")
  winnerUserId Int?
  startedAt    TimestamptzString @default(now())
  endedAt      TimestamptzString?

  @@unique([tableId, handNo])
  @@index([tableId, startedAt])
}

/// Admin on/off switch per game ("poker" | "teen-patti" | "rummy" | "color"). Missing row = enabled.
model GameSetting {
  id        Int      @id @default(autoincrement())
  game      String   @unique
  enabled   Boolean  @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
